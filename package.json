{
  "name": "bullix",
  "version": "1.0.0",
  "description": "Bullix - Cloudflare Serverless & BD Collection Offline-First",
  "private": true,
  "bin": {
    "web": "./scripts/web.js"
  },
  "scripts": {
    "build": "echo 'Static web assets ready in web/'",
