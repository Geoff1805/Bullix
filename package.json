    "pages:deploy": "wrangler pages deploy web",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261012.1",
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3",
    "wrangler": "^4.0.0"
  }
}
