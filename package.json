{
  "name": "bullix",
  "version": "1.0.0",
  "description": "Bullix - Cloudflare Serverless & BD Collection Offline-First",
  "private": true,
  "bin": {
    "web": "./scripts/web.js"
  },
  "scripts": {
    "build": "echo 'Static web assets ready in web/'",
    "d1:create": "wrangler d1 create bullix-db",
    "d1:apply": "wrangler d1 execute bullix-db --file=./schema.sql",
    "d1:seed": "wrangler d1 execute bullix-db --file=./scripts/seeding/schema_seed.sql",
    "seed:generate": "tsx scripts/seeding/import_seed.ts",
    "pages:dev": "wrangler pages dev web",
    "pages:deploy": "wrangler pages deploy web",
    "typecheck": "tsc --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
